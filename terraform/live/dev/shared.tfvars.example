# Environment-wide values. Copy to shared.tfvars (gitignored).
# Every stack is applied with: terraform plan -var-file=../shared.tfvars

project_id        = "ai-rag-agent-project"
org_id            = "183647127415"
region            = "asia-south1"
dr_region         = "asia-south2"
env               = "dev"
state_bucket_name = "ai-rag-agent-project-banking-tfstate-dev"

github_org = "sadaf-jamal-au27"
github_repos = [
  "apex-bank-app",
  "apex-bank-infra",
]

# No Access Policy exists on this org yet — first apply of 03-vpcsc can create one.
access_policy_id       = ""
create_access_policy   = true
enable_vpc_sc          = true
enable_org_policies    = true

k8s_namespace       = "banking-dev"
k8s_service_account = "banking-app"

master_ipv4_cidr = "172.16.0.0/28"
master_authorized_cidrs = [
  {
    cidr_block   = "203.0.113.10/32"
    display_name = "replace-with-corp-vpn"
  },
]

break_glass_members = []
